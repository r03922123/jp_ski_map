exports[`MapView draws (characterization) > empty: every route source stays mounted, empty 1`] = `
<div>
  <div
    data-attribution="{"customAttribution":"Snow: <a href=\\"https://open-meteo.com/\\" target=\\"_blank\\" rel=\\"noopener\\">Open-Meteo</a> | Shuttle: <a href=\\"https://www.hakubavalley.com/en/access_en/shuttlebus_en/\\" target=\\"_blank\\" rel=\\"noopener\\">Hakuba Valley</a> | Places: <a href=\\"https://overturemaps.org/\\" target=\\"_blank\\" rel=\\"noopener\\">Overture Maps Foundation</a> (<a href=\\"https://github.com/r03922123/jp_ski_map/blob/main/DATA-LICENSES.md\\" target=\\"_blank\\" rel=\\"noopener\\">licences</a>)"}"
    data-interactive="["lodging-pins","route-alts-hit"]"
    data-map="true"
  >
    <div
      data-nav-control="true"
    />
    <div
      data-data="{"type":"FeatureCollection","features":[]}"
      data-source="lodging"
    >
      <i
        data-layer="lodging-pins"
        data-style="{"type":"circle","paint":{"circle-radius":6,"circle-color":"#9333ea","circle-stroke-color":"#ffffff","circle-stroke-width":2}}"
      />
      <i
        data-layer="lodging-labels"
        data-style="{"type":"symbol","minzoom":15,"layout":{"text-field":["get","name"],"text-font":["Noto Sans Regular"],"text-size":11,"text-offset":[0,1.2],"text-anchor":"top"},"paint":{"text-color":"#581c87","text-halo-color":"#ffffff","text-halo-width":1.5}}"
      />
    </div>
    <div
      data-data="{"type":"FeatureCollection","features":[]}"
      data-source="route-alts"
    >
      <i
        data-layer="route-alts-casing"
        data-style="{"type":"line","layout":{"line-cap":"round","line-join":"round"},"paint":{"line-color":"#6b7a90","line-width":0}}"
      />
      <i
        data-layer="route-alts-line"
        data-style="{"type":"line","layout":{"line-cap":"round","line-join":"round"},"paint":{"line-color":"#6b7a90","line-width":5,"line-dasharray":[1.2,1.6]}}"
      />
      <i
        data-layer="route-alts-hit"
        data-style="{"type":"line","paint":{"line-color":"#000000","line-opacity":0,"line-width":22}}"
      />
    </div>
    <div
      data-data="{"type":"FeatureCollection","features":[]}"
      data-source="ride"
    >
      <i
        data-layer="ride-casing"
        data-style="{"type":"line","layout":{"line-cap":"round","line-join":"round"},"paint":{"line-color":"#134e4a","line-width":9}}"
      />
      <i
        data-layer="ride-line"
        data-style="{"type":"line","layout":{"line-cap":"round","line-join":"round"},"paint":{"line-color":"#0f766e","line-width":6}}"
      />
    </div>
    <div
      data-data="{"type":"FeatureCollection","features":[]}"
      data-source="route-active"
    >
      <i
        data-layer="route-active-casing"
        data-style="{"type":"line","layout":{"line-cap":"round","line-join":"round"},"paint":{"line-color":"#22223a","line-width":9}}"
      />
      <i
        data-layer="route-active-line"
        data-style="{"type":"line","layout":{"line-cap":"round","line-join":"round"},"paint":{"line-color":"#ffd25e","line-width":4,"line-dasharray":[1.5,2]}}"
      />
    </div>
    <div
      data-data="{"type":"FeatureCollection","features":[]}"
      data-source="route-covered"
    >
      <i
        data-layer="route-covered-line"
        data-style="{"type":"line","layout":{"line-cap":"round","line-join":"round"},"paint":{"line-color":"#9ca3af","line-width":7}}"
      />
    </div>
    <div
      data-data="{"type":"Feature","properties":{},"geometry":{"type":"LineString","coordinates":[]}}"
      data-source="route-highlight"
    >
      <i
        data-layer="route-highlight-line"
        data-style="{"type":"line","layout":{"line-cap":"round","line-join":"round"},"paint":{"line-color":"#f59e0b","line-width":8}}"
      />
    </div>
    <div
      data-data="{"type":"FeatureCollection","features":[]}"
      data-source="ride-stops"
    >
      <i
        data-layer="ride-stop-dots"
        data-style="{"type":"circle","paint":{"circle-radius":["match",["get","role"],"via",5,8],"circle-color":"#ffffff","circle-stroke-color":"#134e4a","circle-stroke-width":["match",["get","role"],"via",2.5,3.5]}}"
      />
      <i
        data-layer="ride-stop-names"
        data-style="{"type":"symbol","layout":{"text-field":["step",["zoom"],["case",["==",["get","role"],"via"],"",["get","name"]],14,["get","name"]],"text-font":["Noto Sans Regular"],"text-size":["match",["get","role"],"via",11,12.5],"text-offset":[0,1.1],"text-anchor":"top","text-max-width":9},"paint":{"text-color":"#134e4a","text-halo-color":"#ffffff","text-halo-width":1.6}}"
      />
    </div>
    <div
      data-anchor="bottom"
      data-marker-at="137.83,36.69"
      data-style="{"zIndex":1}"
    >
      <button
        aria-label="Hakuba Happo-One Snow Resort"
        aria-pressed="false"
        class="flex items-center gap-1 border-2 border-[var(--ink)] py-0.5 pr-1.5 pl-0.5 text-xs shadow-[2px_2px_0_var(--ink)] bg-card text-card-foreground"
        data-resort-marker="happo-one"
        type="button"
      >
        <img
          alt=""
          class="[image-rendering:pixelated] "
          height="16"
          width="16"
        />
        Hakuba Happo-One
      </button>
    </div>
    <div
      data-anchor="bottom"
      data-marker-at="137.82,36.66"
      data-style="{"zIndex":2}"
    >
      <button
        aria-label="Hakuba Goryu Ski Resort"
        aria-pressed="true"
        class="flex items-center gap-1 border-2 border-[var(--ink)] py-0.5 pr-1.5 pl-0.5 text-xs shadow-[2px_2px_0_var(--ink)] bg-primary text-primary-foreground"
        data-resort-marker="goryu"
        type="button"
      >
        <img
          alt=""
          class="[image-rendering:pixelated] "
          height="16"
          width="16"
        />
        Hakuba Goryu
      </button>
    </div>
  </div>
</div>
`;

